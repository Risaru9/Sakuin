generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CASH
  BANK
  E_WALLET
  SAVINGS
  OTHER
}

model User {
  id                   String         @id @default(cuid())
  name                 String
  email                String         @unique
  passwordHash         String?
  safeBalanceLimit     Decimal        @default(0) @db.Decimal(18, 2)
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  transactions         Transaction[]
  accounts             Account[]
  accountTransfers     AccountTransfer[]
  goals                Goal[]
  categories           Category[]
  auditLogs            AuditLog[]
  oauthAccounts        OauthAccount[]
  emailConnections     EmailConnection[]
  emailTransactionImports EmailTransactionImport[]
  pushSubscriptions    PushSubscription[]
  reminderPreference   ReminderPreference?
  recurringRules       RecurringRule[]
  recurringRuns        RecurringRuleRun[]
  chatMessages         ChatMessage[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

model OauthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("OAuthAccount")
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  accountId   String?
  categoryId  String
  type        TransactionType
  amount      Decimal         @db.Decimal(18, 2)
  note        String?
  date        DateTime
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category    Category        @relation(fields: [categoryId], references: [id])
  recurringRuns RecurringRuleRun[]
  emailImport  EmailTransactionImport?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, date])
  @@index([userId, type])
  @@index([accountId, date])
  @@index([categoryId])
}

model Account {
  id                String            @id @default(cuid())
  userId            String
  name              String
  type              AccountType
  initialBalance    Decimal           @default(0) @db.Decimal(18, 2)
  icon              String?
  color             String?
  isArchived        Boolean           @default(false)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  outgoingTransfers AccountTransfer[] @relation("TransferFromAccount")
  incomingTransfers AccountTransfer[] @relation("TransferToAccount")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, name])
  @@index([userId, isArchived])
}

model AccountTransfer {
  id            String   @id @default(cuid())
  userId        String
  fromAccountId String
  toAccountId   String
  amount        Decimal  @db.Decimal(18, 2)
  note          String?
  date          DateTime
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount   Account  @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, date])
  @@index([fromAccountId, date])
  @@index([toAccountId, date])
}

model Goal {
  id            String        @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal       @db.Decimal(18, 2)
  currentAmount Decimal       @default(0) @db.Decimal(18, 2)
  deadline      DateTime?
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  history       GoalHistory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
}

model GoalHistory {
  id            String   @id @default(cuid())
  goalId        String
  amount        Decimal  @db.Decimal(18, 2)
  currentAmount Decimal  @db.Decimal(18, 2)
  createdAt     DateTime @default(now())

  goal          Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model Category {
  id           String          @id @default(cuid())
  userId       String?
  name         String
  type         TransactionType
  icon         String?
  color        String?
  isDefault    Boolean         @default(false)
  limit        Decimal?        @db.Decimal(18, 2)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringRules RecurringRule[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, type])
  @@unique([userId, name, type])
}

model EmailConnection {
  id                    String   @id @default(cuid())
  userId                String
  provider              String
  emailAddress          String
  providerAccountId     String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  accessTokenExpiresAt  DateTime?
  scopes                Json?
  status                String   @default("active")
  historyId             String?
  detectedProviders     Json?
  lastSyncedAt          DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imports               EmailTransactionImport[]

  @@unique([userId, provider, emailAddress])
  @@index([userId, status])
}

model EmailTransactionImport {
  id                    String           @id @default(cuid())
  userId                String
  emailConnectionId     String?
  gmailMessageId        String?
  emailFingerprint      String
  transactionFingerprint String
  sourceProvider        String           @default("gmail")
  financialProvider     String
  rawSubject            String?
  snippet               String?
  parsedType            TransactionType?
  parsedAmount          Decimal?         @db.Decimal(18, 2)
  parsedMerchant        String?
  parsedMethod          String?
  parsedReference       String?
  parsedOccurredAt      DateTime?
  confidence            Float            @default(0)
  status                String           @default("needs_review")
  statusReason          String?
  transactionId         String?          @unique
  metadata              Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailConnection       EmailConnection? @relation(fields: [emailConnectionId], references: [id], onDelete: SetNull)
  transaction           Transaction?     @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([userId, emailFingerprint])
  @@index([userId, status, createdAt])
  @@index([userId, transactionFingerprint])
  @@index([emailConnectionId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  eventType   String
  status      String
  requestId   String?
  actorType   String
  actorUserId String?
  targetType  String
  targetId    String?
  metadata    Json
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@index([requestId])
  @@index([targetType, targetId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model ReminderPreference {
  id                       String    @id @default(cuid())
  userId                   String    @unique
  enabled                  Boolean   @default(false)
  frequency                String    @default("EVENING")
  eveningHour              Int       @default(20)
  quietStartHour           Int       @default(21)
  quietEndHour             Int       @default(7)
  maxPerDay                Int       @default(1)
  timezoneOffsetMinutes    Int       @default(-420)
  dailyReviewCompletedDate String?
  lastReminderDate         String?
  reminderCountToday       Int       @default(0)
  lastReminderSentAt       DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecurringRule {
  id             String          @id @default(cuid())
  userId         String
  categoryId     String
  type           TransactionType
  amount         Decimal         @db.Decimal(18, 2)
  note           String?
  frequency      String
  interval       Int             @default(1)
  dayOfMonth     Int?
  dayOfWeek      Int?
  startDate      DateTime
  endDate        DateTime?
  nextRunAt      DateTime
  autoPost       Boolean         @default(true)
  isActive       Boolean         @default(true)
  lastRunAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  runs           RecurringRuleRun[]

  @@index([userId, isActive, nextRunAt])
  @@index([categoryId])
}

model RecurringRuleRun {
  id             String   @id @default(cuid())
  userId         String
  recurringRuleId String
  occurrenceDate DateTime
  transactionId  String?
  createdAt      DateTime @default(now())

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringRule  RecurringRule @relation(fields: [recurringRuleId], references: [id], onDelete: Cascade)
  transaction    Transaction?  @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([recurringRuleId, occurrenceDate])
  @@index([userId, occurrenceDate])
  @@index([transactionId])
}

model ChatMessage {
  id                String   @id @default(cuid())
  userId            String
  role              String   // "user" | "assistant" | "system"
  content           String   @db.Text
  intent            String?
  cards             Json?    // Array of AiChatCard
  suggestions       Json?    // Array of string
  transactionDraft  Json?    // AiTransactionDraft
  transactionDrafts Json?    // Array of AiTransactionDraft
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
