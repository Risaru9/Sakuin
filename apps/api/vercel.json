{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/reminders/run",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/ai/proactive-insight",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/email-imports/gmail/auto-sync",
      "schedule": "0 * * * *"
    }
  ]
}
