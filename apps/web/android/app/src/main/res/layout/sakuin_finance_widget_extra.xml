<?xml version="1.0" encoding="utf-8"?>
<!-- Besar (4x3): month header, Saku with today's spending and what is left, the category closest
     to its limit, the last entry and a full-width "+ Catat".
     Only RemoteViews-safe views and system fonts; WidgetLayoutSafetyTest checks this.
     The card background carries a 4dp shadow on the right and bottom, so those paddings are 4dp larger. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/saku_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="18dp"
    android:paddingBottom="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="September"
            android:textColor="#1D1A33"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="diperbarui 10.12"
            android:textColor="#625D78"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_refresh_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/saku_refresh"
            android:contentDescription="Muat ulang widget"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="↻"
            android:textColor="#1D1A33"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_mascot"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:contentDescription="Saku"
            android:src="@drawable/saku_wow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_today_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Keluar hari ini"
                android:textColor="#625D78"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_today"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="13sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-black"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="43.000"
                android:textColor="#1D1A33"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_left_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Sisa bulan ini"
                android:textColor="#625D78"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_left"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:autoSizeMaxTextSize="22sp"
                android:autoSizeMinTextSize="13sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-black"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="1.240.500"
                android:textColor="#1D1A33"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_login_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="#625D78"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/widget_budget_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/saku_white"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_budget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Makanan 86% dari batas"
            android:textColor="#8A5A00"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/widget_budget_bar"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="5dp">

            <ProgressBar
                android:id="@+id/widget_progress_ok"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progressDrawable="@drawable/saku_progress_ok"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/widget_progress_watch"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="86"
                android:progressDrawable="@drawable/saku_progress_watch" />

            <ProgressBar
                android:id="@+id/widget_progress_over"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progressDrawable="@drawable/saku_progress_over"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_last"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Terakhir: Kopi susu −18.000"
        android:textColor="#625D78"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_quick_add_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/saku_button"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:text="+ Catat"
        android:textColor="#1D1A33"
        android:textSize="16sp" />
</LinearLayout>
