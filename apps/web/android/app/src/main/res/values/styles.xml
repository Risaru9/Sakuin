<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/sakuin_splash_background</item>
        <item name="android:windowBackground">@color/sakuin_splash_background</item>
        <item name="android:navigationBarColor">@color/sakuin_splash_background</item>
        <item name="android:statusBarColor">@color/sakuin_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/sakuin_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_saku</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/saku_coin</item>
        <item name="windowSplashScreenBackground">@color/sakuin_splash_background</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
<style name="AppTheme.QuickEntry" parent="Theme.AppCompat.Light.NoActionBar">
<item name="android:windowIsTranslucent">true</item><item name="android:windowBackground">@android:color/transparent</item><item name="android:backgroundDimEnabled">true</item><item name="android:backgroundDimAmount">0.55</item><item name="android:windowActionModeOverlay">true</item><item name="android:colorAccent">@color/saku_coin</item><item name="android:windowNoTitle">true</item><item name="android:windowAnimationStyle">@null</item><item name="android:fontFamily">@font/nunito_extrabold</item>
</style></resources>
