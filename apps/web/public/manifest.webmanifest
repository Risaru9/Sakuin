{
  "id": "/",
  "name": "Sakuin",
  "short_name": "Sakuin",
  "description": "Personal finance app untuk mencatat transaksi, membaca ringkasan uang, memantau goals, dan membangun kebiasaan finansial harian.",
  "lang": "id",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "categories": ["finance", "productivity", "utilities"],
