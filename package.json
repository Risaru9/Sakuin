{
  "name": "sakuin",
  "version": "0.1.0",
  "private": true,
  "description": "Sakuin adalah webapp pengelola keuangan pribadi berbasis monorepo.",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @sakuin/api dev",
    "dev:api": "pnpm --filter @sakuin/api dev",
    "dev:web": "pnpm --filter @sakuin/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}